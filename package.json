{
  "name": "consultix-technologies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler pages dev dist --port 8788",
    "dev:full": "npm run build && wrangler pages dev dist --port 8788",
    "build": "npm run typecheck && vite build && tsx scripts/prerender.ts && tsx scripts/security-check.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.40.0"
  }
}
